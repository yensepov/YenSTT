<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YenSTT</AssemblyName>
    <Product>YenSTT</Product>
    <Title>YenSTT</Title>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Authors>yensepov</Authors>
    <Description>Private local speech-to-text utility powered by faster-whisper</Description>
    <Copyright>Copyright © 2026 yensepov contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yensepov/YenSTT</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Python\faster_whisper_worker.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Python\requirements.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="LICENSE">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="README.md">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="THIRD_PARTY_NOTICES.md">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyFasterWhisperRuntime" AfterTargets="Publish"
          Condition="Exists('artifacts\faster-whisper-runtime\faster-whisper-worker')">
    <ItemGroup>
      <FasterWhisperRuntimeFiles Include="artifacts\faster-whisper-runtime\faster-whisper-worker\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(FasterWhisperRuntimeFiles)"
      DestinationFiles="@(FasterWhisperRuntimeFiles->'$(PublishDir)Runtime\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
